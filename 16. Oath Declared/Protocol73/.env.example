# Copy this file to .env, then replace both values before running.
P73_FLAG=FLAG{REPLACE_THIS_WITH_YOUR_REAL_FLAG}
P73_FLASK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
P73_ENV=development
P73_SECURE_COOKIE=0

# Optional tuning (defaults are suitable for local testing)
# P73_THREADS=8
# PORT=5000
P73_REQUIRED_COUNT=120
# P73_PARSE_CACHE_MAX=256
