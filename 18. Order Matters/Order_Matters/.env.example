# Set your own competition flag before building a new matching site+PCAP pair.
ORDER_MATTERS_FLAG=kernel{replace_this_before_building}
ORDER_MATTERS_HOST=127.0.0.1
ORDER_MATTERS_PORT=8000
# Set true when serving over HTTPS so the session cookie has the Secure attribute.
ORDER_MATTERS_HTTPS=false
# Set true for request logs during local debugging.
ORDER_MATTERS_LOG=false
